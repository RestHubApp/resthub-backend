{
  "version": "1.0.0",
  "title": "Nueva medición de cinco lecturas corregidas bajo cuatro fallas",
  "description": "Se repite el recorrido Playwright de las cinco rutas con reintento añadido a su lectura principal.",
  "steady-state-hypothesis": {"title": "Cinco rutas recuperables con 500, 409, 503 y timeout", "probes": [
    {"type": "probe", "name": "backend-sano", "tolerance": true, "provider": {"type": "python", "module": "resthub_chaos.api", "func": "salud_ok"}},
    {"type": "probe", "name": "cinco-rutas-con-reintento", "tolerance": true, "provider": {"type": "python", "module": "resthub_chaos.escenarios", "func": "rutas_corregidas_cumplen"}}
  ]},
  "method": [
    {"type": "action", "name": "limpiar-observaciones", "provider": {"type": "python", "module": "resthub_chaos.api", "func": "borrar_observaciones"}},
    {"type": "action", "name": "sesion-encargado", "provider": {"type": "python", "module": "resthub_chaos.ui", "func": "abrir_sesion", "arguments": {"correo": "admin@resthub.dev", "movil": false}}},
    {"type": "probe", "name": "medir-cinco-rutas", "provider": {"type": "python", "module": "resthub_chaos.escenarios", "func": "medir_rutas_corregidas"}}
  ],
  "rollbacks": [
    {"type": "action", "name": "proxy-sano", "provider": {"type": "python", "module": "resthub_chaos.escenarios", "func": "limpiar"}},
    {"type": "action", "name": "cerrar-navegador", "provider": {"type": "python", "module": "resthub_chaos.ui", "func": "cerrar"}},
    {"type": "action", "name": "archivar", "provider": {"type": "python", "module": "resthub_chaos.api", "func": "archivar_observaciones", "arguments": {"destino": "/tmp/caos-resthub/04b-observaciones.json"}}}
  ]
}
