{
  "version": "1.0.0",
  "title": "Reintento de lectura de mesas ante respuesta 409",
  "description": "Repite la lectura de mesas con el 409 inyectado y comprueba el mensaje y botón de reintento.",
  "steady-state-hypothesis": {"title": "Mesas presenta error y reintento", "probes": [
    {"type": "probe", "name": "backend-sano", "tolerance": true, "provider": {"type": "python", "module": "resthub_chaos.api", "func": "salud_ok"}},
    {"type": "probe", "name": "mesas-con-reintento", "tolerance": true, "provider": {"type": "python", "module": "resthub_chaos.escenarios", "func": "rutas_corregidas_cumplen"}}
  ]},
  "method": [
    {"type": "action", "name": "limpiar-observaciones", "provider": {"type": "python", "module": "resthub_chaos.api", "func": "borrar_observaciones"}},
    {"type": "action", "name": "sesion-encargado", "provider": {"type": "python", "module": "resthub_chaos.ui", "func": "abrir_sesion", "arguments": {"correo": "admin@resthub.dev", "movil": false}}},
    {"type": "probe", "name": "medir-mesas-409", "provider": {"type": "python", "module": "resthub_chaos.escenarios", "func": "medir_rutas_corregidas", "arguments": {"rutas": ["/mesas"], "fallas": ["409"]}}}
  ],
  "rollbacks": [
    {"type": "action", "name": "proxy-sano", "provider": {"type": "python", "module": "resthub_chaos.escenarios", "func": "limpiar"}},
    {"type": "action", "name": "cerrar-navegador", "provider": {"type": "python", "module": "resthub_chaos.ui", "func": "cerrar"}},
    {"type": "action", "name": "archivar", "provider": {"type": "python", "module": "resthub_chaos.api", "func": "archivar_observaciones", "arguments": {"destino": "/tmp/caos-resthub/04d-observaciones.json"}}}
  ]
}
