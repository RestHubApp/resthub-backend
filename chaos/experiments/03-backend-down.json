{
  "version": "1.0.0",
  "title": "SIGKILL del backend al enviar el pedido del mesero",
  "description": "Se mata el proceso local antes de enviar desde el navegador y se comprueba cola y pedido único después del reinicio.",
  "steady-state-hypothesis": {"title": "Tras el reintento hay exactamente un pedido", "probes": [
    {"type": "probe", "name": "pedido-unico-tras-reintento", "tolerance": true, "provider": {"type": "python", "module": "resthub_chaos.scenarios", "func": "exact_order"}},
    {"type": "probe", "name": "backend-sano-al-final", "tolerance": true, "provider": {"type": "python", "module": "resthub_chaos.api", "func": "health_ok"}}
  ]},
  "method": [
    {"type": "action", "name": "limpiar-observaciones", "provider": {"type": "python", "module": "resthub_chaos.api", "func": "clear_observations"}},
    {"type": "action", "name": "mesero-prepara-el-pedido", "provider": {"type": "python", "module": "resthub_chaos.scenarios", "func": "prepare_order"}},
    {"type": "action", "name": "sigkill-backend", "provider": {"type": "python", "module": "resthub_chaos.process", "func": "kill_backend"}},
    {"type": "probe", "name": "mesero-envia-sin-backend", "provider": {"type": "python", "module": "resthub_chaos.scenarios", "func": "submit_with_backend_down"}},
    {"type": "action", "name": "reiniciar-backend", "provider": {"type": "python", "module": "resthub_chaos.process", "func": "start_backend"}},
    {"type": "probe", "name": "mesero-reintenta-y-verifica-base", "provider": {"type": "python", "module": "resthub_chaos.scenarios", "func": "retry_after_start"}}
  ],
  "rollbacks": [
    {"type": "action", "name": "backend-arriba", "provider": {"type": "python", "module": "resthub_chaos.process", "func": "start_backend"}},
    {"type": "action", "name": "cerrar-navegador", "provider": {"type": "python", "module": "resthub_chaos.ui", "func": "close"}},
    {"type": "action", "name": "archivar", "provider": {"type": "python", "module": "resthub_chaos.api", "func": "archive_observations", "arguments": {"destination": "/tmp/caos-resthub/03-observaciones.json"}}}
  ]
}
