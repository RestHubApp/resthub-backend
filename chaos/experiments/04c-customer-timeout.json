{
  "version": "1.0.0",
  "title": "Reintento de la lectura de clientes tras dos plazos agotados",
  "description": "La consulta a clientes puede agotar el plazo de Axios dos veces: se espera 40 s antes del veredicto.",
  "steady-state-hypothesis": {"title": "Clientes muestra error y reintento", "probes": [
    {"type": "probe", "name": "backend-sano", "tolerance": true, "provider": {"type": "python", "module": "resthub_chaos.api", "func": "health_ok"}},
    {"type": "probe", "name": "cliente-con-reintento", "tolerance": true, "provider": {"type": "python", "module": "resthub_chaos.scenarios", "func": "fixed_routes_pass"}}
  ]},
  "method": [
    {"type": "action", "name": "limpiar-observaciones", "provider": {"type": "python", "module": "resthub_chaos.api", "func": "clear_observations"}},
    {"type": "action", "name": "sesion-encargado", "provider": {"type": "python", "module": "resthub_chaos.ui", "func": "open_session", "arguments": {"email": "admin@resthub.dev", "mobile": false}}},
    {"type": "probe", "name": "medir-clientes-timeout", "provider": {"type": "python", "module": "resthub_chaos.scenarios", "func": "measure_fixed_routes", "arguments": {"routes": ["/clientes"], "faults": ["timeout"]}}}
  ],
  "rollbacks": [
    {"type": "action", "name": "proxy-sano", "provider": {"type": "python", "module": "resthub_chaos.scenarios", "func": "clear_rules"}},
    {"type": "action", "name": "cerrar-navegador", "provider": {"type": "python", "module": "resthub_chaos.ui", "func": "close"}},
    {"type": "action", "name": "archivar", "provider": {"type": "python", "module": "resthub_chaos.api", "func": "archive_observations", "arguments": {"destination": "/tmp/caos-resthub/04c-observaciones.json"}}}
  ]
}
