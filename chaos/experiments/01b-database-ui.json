{
  "version": "1.0.0",
  "title": "Mesero durante la caída de PostgreSQL y la recuperación",
  "description": "Complemento visual del experimento de base: se abre la pantalla del mesero, cae PostgreSQL y se verifican el aviso 503 y el reintento al volver.",
  "steady-state-hypothesis": {"title": "La pantalla muestra error y se recupera", "probes": [
    {"type": "probe", "name": "backend-sano", "tolerance": true, "provider": {"type": "python", "module": "resthub_chaos.api", "func": "health_ok"}},
    {"type": "probe", "name": "mesero-recuperado", "tolerance": true, "provider": {"type": "python", "module": "resthub_chaos.ui", "func": "screen_recovered", "arguments": {"key": "base_ui_recuperada"}}}
  ]},
  "method": [
    {"type": "action", "name": "limpiar-observaciones", "provider": {"type": "python", "module": "resthub_chaos.api", "func": "clear_observations"}},
    {"type": "action", "name": "mesero-conectado", "provider": {"type": "python", "module": "resthub_chaos.ui", "func": "open_session"}},
    {"type": "action", "name": "postgres-cae", "provider": {"type": "python", "module": "resthub_chaos.process", "func": "stop_database_immediately"}},
    {"type": "probe", "name": "pantalla-bajo-falla", "provider": {"type": "python", "module": "resthub_chaos.ui", "func": "observe_under_fault", "arguments": {"key": "base_ui_falla", "route": "/pedidos", "capture_at": [2], "limit_s": 30, "prefix": "01-base-caida"}}},
    {"type": "action", "name": "postgres-vuelve", "provider": {"type": "python", "module": "resthub_chaos.process", "func": "start_database"}},
    {"type": "probe", "name": "pantalla-tras-reintento", "provider": {"type": "python", "module": "resthub_chaos.ui", "func": "retry_and_observe", "arguments": {"key": "base_ui_recuperada", "prefix": "01-base-recuperada"}}}
  ],
  "rollbacks": [
    {"type": "action", "name": "postgres-arriba", "provider": {"type": "python", "module": "resthub_chaos.process", "func": "start_database"}},
    {"type": "action", "name": "cerrar-navegador", "provider": {"type": "python", "module": "resthub_chaos.ui", "func": "close"}},
    {"type": "action", "name": "archivar", "provider": {"type": "python", "module": "resthub_chaos.api", "func": "archive_observations", "arguments": {"destination": "/tmp/caos-resthub/01b-observaciones.json"}}}
  ]
}
