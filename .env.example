# Copiar a .env y ajustar. Nunca versionar el archivo con valores reales.

APP_NAME=resthub-api
APP_VERSION=0.1.0
# Sin la variable la aplicación arranca en modo producción (DEBUG=false): exige
# PostgreSQL, un JWT_SECRET_KEY propio, DATA_ENCRYPTION_KEY y no publica /docs.
# En local va en true.
DEBUG=true

# Logs: nivel mínimo (DEBUG, INFO, WARNING o ERROR) y formato. En un despliegue
# conviene LOG_JSON=true, una línea JSON por evento para el recolector.
LOG_LEVEL=INFO
LOG_JSON=false

# Panel de observabilidad (/plataforma/observabilidad): peticiones y avisos se
# guardan en la propia base y se borran pasados estos días. false lo apaga.
OBSERVABILITY_ENABLED=true
OBSERVABILITY_RETENTION_DAYS=14
# Filas por minuto (peticiones más avisos) que guarda cada proceso; lo que pasa
# se descarta y se cuenta en el panel. 0 quita el tope.
OBSERVABILITY_MAX_ROWS_PER_MINUTE=6000

# SQLite local para empezar sin nada instalado. Con PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://resthub:resthub_dev_only@127.0.0.1:5432/resthub
DATABASE_URL=sqlite+aiosqlite:///./resthub.db
# TLS hacia PostgreSQL: disable, prefer (por omisión), require, verify-ca o
# verify-full. En producción, require o verify-full (con DATABASE_SSL_ROOT_CERT si
# la CA no es pública). No aplica a SQLite.
# DATABASE_SSL_MODE=require
# DATABASE_SSL_ROOT_CERT=
# Segundos que puede durar una petición antes de que el servidor la corte con
# un 503 (menos que los 15 s del frontend). La IA y los comprobantes no lo tienen.
REQUEST_DEADLINE_SECONDS=12

# Lista JSON o separada por comas: https://a.example.com,https://b.example.com
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
# Opcional: patrón para orígenes que cambian en cada despliegue (previews de
# Vercel). El origen tiene que calzar entero, p. ej.
# https://resthub-frontend-[a-z0-9-]+-mi-equipo\.vercel\.app
CORS_ALLOWED_ORIGIN_REGEX=
# Origen del frontend; se declara ante OpenRouter como HTTP-Referer.
FRONTEND_BASE_URL=http://localhost:5173

# Cookie de sesión. `Secure` siempre en producción: con DEBUG=false y
# SESSION_COOKIE_SECURE=false la aplicación no arranca. En local por http:
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_SAMESITE=lax

# Solo en un entorno de demostración desplegado: deja que seed_dev y
# seed_history escriban en una base no local o con DEBUG=false.
ALLOW_DEMO_SEED=false

# Firma de los tokens de acceso. Mínimo 32 bytes, y con DEBUG=false la
# aplicación se niega a arrancar si conserva este valor de ejemplo.
# Generar uno propio:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=cambiame-solo-sirve-en-desarrollo
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=3600

# Cifrado en reposo de los datos personales de clientes (Ley N.º 29733).
# 32 bytes en base64. Vacía solo sirve con DEBUG=true (usa una llave pública de
# desarrollo); con DEBUG=false la aplicación no arranca sin ella.
# Generar una:  python -m resthub.core.data_keys
# NUNCA la pierdas ni la cambies sin rotarla (README, «Cifrado en reposo»).
DATA_ENCRYPTION_KEY=
# Solo durante una rotación: las llaves anteriores, separadas por comas.
DATA_ENCRYPTION_PREVIOUS_KEYS=

# IA por OpenRouter (https://openrouter.ai/keys). Vacío = apagada.
# El modelo principal y uno de respaldo; se cambian sin tocar código.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_TIMEOUT_SECONDS=45

# Decisiones con Jev, de TypeSafe AI (https://console.typesafe.ai/keys).
# Con TYPESAFE_API_KEY se llama a TypeSafe directo; si está vacía pero hay
# OPENROUTER_API_KEY, Jev se llama por OpenRouter (basta esa clave). Sin
# ninguna = deciden las reglas fijas; todo funciona igual. La clave nunca se
# escribe en los logs.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest
# Modelo de Jev por OpenRouter (solo si no hay TYPESAFE_API_KEY).
JEV_OPENROUTER_MODEL=~typesafe/jev-latest
# Pasado este tiempo, o con una confianza menor a AI_MIN_CONFIDENCE, la
# decisión la toman las reglas y queda anotado por qué.
TYPESAFE_TIMEOUT_SECONDS=3
AI_MIN_CONFIDENCE=0.5

# Lycet (API REST de Greenter): firma las boletas y facturas y las envía a SUNAT. En local se
# levanta con `docker compose -f docker/lycet/compose.yml up -d --build` (entorno BETA de
# SUNAT; ver README). LYCET_TOKEN es el CLIENT_TOKEN de esa instancia. Con alguno vacío, los
# comprobantes quedan «sin enviar». Nunca se escriben en logs.
LYCET_URL=
LYCET_TOKEN=

# Correo de comprobantes por la API HTTPS de Brevo (https://app.brevo.com/settings/keys/api).
# Railway bloquea el SMTP saliente, por eso no es SMTP. Con la clave o el remitente vacíos la
# función queda apagada y la pantalla no ofrece «Enviar por correo». El remitente tiene que
# estar verificado en Brevo. Nunca se escriben en logs.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=RestHub
# Correos de comprobantes que puede enviar una cuenta por hora.
EMAIL_MAX_PER_HOUR=20

# Respaldo de comprobantes (PDF y XML) en Google Drive. Con alguna vacía, el respaldo queda
# apagado. El refresh token y la carpeta se obtienen con scripts/drive_authorize.py (ver README).
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Autocompletar con RUC/DNI por Factiliza (https://docs.factiliza.com). Vacío =
# función apagada y el frontend no ofrece el botón. El token nunca se escribe en
# los logs. El plan gratuito da 100 consultas al mes.
FACTILIZA_TOKEN=
# FACTILIZA_BASE_URL=https://api.factiliza.com/v1
# FACTILIZA_TIMEOUT_SECONDS=5
# Memoria de búsquedas resueltas (segundos) y búsquedas por minuto de cada cuenta.
# LOOKUP_CACHE_SECONDS=600
# LOOKUP_PER_MINUTE=10

# Trazas OpenTelemetry (OTLP/HTTP). Vacío = apagadas, sin costo. Con un colector,
# por ejemplo el de Railway o Grafana Cloud: la ruta /v1/traces se agrega sola.
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer clave
# OTEL_SERVICE_NAME=resthub-api
# OTEL_TRACES_SAMPLER_ARG=1.0

# Prevención de fugas internas: si una cuenta abre o exporta más de
# DLP_ALERT_MAX_CARDS fichas de clientes en DLP_ALERT_WINDOW_MINUTES minutos,
# queda una alerta en la bitácora y se avisa a quien la puede ver.
DLP_ALERT_MAX_CARDS=20
DLP_ALERT_WINDOW_MINUTES=10
